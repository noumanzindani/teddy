# Copy to api/.env.server on your server and fill in the two JWT keys.
# DATABASE_URL and REDIS_URL are set by docker-compose.prod.yml (compose service names),
# so you do NOT need them here.

NODE_ENV=production
PORT=4000

# CORS — the front-end origins that call this API (comma-separated, no trailing slash).
CORS_ORIGINS=https://teddy-vendor-app.web.app,https://teddy-user-app.web.app,exp://localhost:8081

# JWT RS256 keys, base64-encoded. Generate on the server:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   echo "JWT_PRIVATE_KEY_B64=$(base64 -w0 private.pem)"
#   echo "JWT_PUBLIC_KEY_B64=$(base64 -w0 public.pem)"
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# External integrations stay mocked for the demo (no real Stripe/SMS/email/push needed).
PAYMENT_MOCK_MODE=true
EMAIL_MOCK_MODE=true
OTP_MOCK_MODE=true
PUSH_MOCK_MODE=true
MEDIA_MOCK_MODE=true

# Business config
PLATFORM_COMMISSION_RATE=0.15
POINTS_PER_DOLLAR=100
PAYOUT_DELAY_DAYS=2
AUTO_FINALIZE_HOURS=24
