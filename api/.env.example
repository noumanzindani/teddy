# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,exp://localhost:8081

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://teddy:teddy_dev_pass@localhost:5432/teddy_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (RS256 — generate with openssl) ──────────────────────────────────────
# openssl genrsa -out keys/private.pem 2048
# openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Payment (MOCK — replace with real Stripe keys for production) ─────────────
PAYMENT_MOCK_MODE=true
STRIPE_SECRET_KEY=sk_test_MOCK_REPLACE_WITH_REAL
STRIPE_WEBHOOK_SECRET=whsec_MOCK_REPLACE_WITH_REAL
STRIPE_PLATFORM_ACCOUNT=acct_MOCK_REPLACE_WITH_REAL

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_REAL
GOOGLE_CLIENT_SECRET=REPLACE_WITH_REAL

# ── OTP / SMS (MOCK — console log in dev, Twilio in prod) ────────────────────
OTP_MOCK_MODE=true
TWILIO_ACCOUNT_SID=REPLACE_WITH_REAL
TWILIO_AUTH_TOKEN=REPLACE_WITH_REAL
TWILIO_PHONE_NUMBER=+10000000000

# ── Email (MOCK — console log in dev, SendGrid in prod) ──────────────────────
EMAIL_MOCK_MODE=true
SENDGRID_API_KEY=REPLACE_WITH_REAL
SENDGRID_FROM_EMAIL=noreply@teddy.app

# ── Push Notifications (MOCK — console log in dev) ───────────────────────────
PUSH_MOCK_MODE=true
EXPO_ACCESS_TOKEN=REPLACE_WITH_REAL

# ── Media / S3 (MOCK — local paths returned in dev) ──────────────────────────
MEDIA_MOCK_MODE=true
AWS_ACCESS_KEY_ID=REPLACE_WITH_REAL
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_REAL
AWS_REGION=us-east-1
S3_BUCKET_NAME=teddy-assets
CLOUDFRONT_URL=https://media.teddy.app

# ── Business Rules ────────────────────────────────────────────────────────────
PLATFORM_COMMISSION_RATE=0.15
POINTS_PER_DOLLAR=10
PAYOUT_DELAY_DAYS=2
